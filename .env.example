# AICPQ environment template — copy to .env.local (never commit secrets)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_PROJECT_REF=your_project_ref
# Prefer Supabase pooler (IPv4) for Node migrations/scripts
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
OPENAI_API_KEY=sk-...
# Preferred model id; app falls back if unavailable
OPENAI_MODEL=gpt-5.6
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43127
DEMO_MODE=true
